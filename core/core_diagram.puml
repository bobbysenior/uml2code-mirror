@startuml

abstract class Language {
  #elements
  +toCode()
}

abstract class Relation {
  +Class source
  +Class destination
  +str sourceCardinality
  +str destinationCardinality
}

abstract class Extension {

}
abstract class Dependency {}
abstract class Agregation {}
abstract class Composition {}

abstract class Class {
  +int id
  +str name
  +addAttribute(Attribute)
  +addMethod(Method)
  +toCode()
}

abstract class Method {
  +str name
  +str accessSpecifier
  +str parameters[]
  +str returnType
  +str returnValue
  +toCode()
}

abstract class Attribute {
  str accessSpecifier
  str type
  str name
  +toCode()
}

abstract class Interface {
}

Interface --|> Class

Attribute "*" --* "1" Class : < possède
Method "*" --* "1" Class : < possède
Interface "*" --o "*" Class : implémente <
Class "*" --> "1" Class : Spécialise

Relation <|-- Extension
Relation <|-- Dependency
Relation <|-- Agregation
Relation <|-- Composition


Language o-- Relation
Language o-- Class

@enduml
