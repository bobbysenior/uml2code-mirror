@startuml

' ===== Classes =====
class BankAccount {
    -balance : double
    +deposit() : void
    +withdraw() : void
}
note right of BankAccount
  Représente un compte bancaire avec solde et opérations possibles
end note

class CreditCard {
    -cardNumber : String
    -coucou : int
    +charge() : void
    +pay(customer : Customer, amount : int) : void
}
note right of CreditCard
  Une carte de crédit
end note

class Customer {
    -name : String
}
note right of Customer
  Cette classe contient les informations relatives à un client, telles que le nom et le compte bancaire.
end note

abstract class Wallet {
    -amount : double
    +addMoney() : void
}
note right of Wallet
  Un porte-monnaie abstrait pouvant contenir de l'argent
end note

interface IPaymentProcessor {
    +processPayment() : void
}
note right of IPaymentProcessor
  Interface pour les objets pouvant traiter un paiement
end note

' ===== Héritage =====
CreditCard --|> Wallet

' ===== Implémentation d'interface =====
CreditCard ..|> IPaymentProcessor

' ===== Relations =====
BankAccount  -->  CreditCard : "linked card"        ' association directionnelle
Customer  o--  BankAccount : "owns"                    ' agrégation bidirectionnelle
Customer  *--  Wallet : "holds"                        ' composition bidirectionnelle
BankAccount  --  Customer : "primary holder"        ' association bidirectionnelle

@enduml
